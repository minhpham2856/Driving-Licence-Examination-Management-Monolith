# Copy to sepay.env (same folder) khi Tomcat không đọc được root .env.
# LƯU Ý: Nếu web.xml có dlem.env.path trỏ tới root .env thì file đó được ưu tiên hơn sepay.env.

sepay.env=production
sepay.merchantId=YOUR_SANDBOX_MERCHANT_ID
sepay.secretKey=YOUR_SANDBOX_SECRET_KEY
sepay.checkoutUrl=https://pay-sandbox.sepay.vn/v1/checkout/init
sepay.appBaseUrl=https://YOUR-SUBDOMAIN.ngrok-free.dev/Driving-Licence-Examination-Management-Monolith
sepay.returnBaseUrl=http://localhost:8080/Driving-Licence-Examination-Management-Monolith
