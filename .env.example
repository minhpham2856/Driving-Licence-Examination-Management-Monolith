# Copy this file to ".env" in the project root (next to src/) and fill in your values.
# OS environment variables override .env if both are set.

# Database (SQL Server)
DB_URL=jdbc:sqlserver://localhost\\SQLEXPRESS:1433;databaseName=DLEM_DB_2
DB_USER=sa
DB_PASSWORD=your_db_password

# Gmail SMTP (use App Password, not your normal Gmail password)
# Spaces in the app password are OK - they are stripped automatically.
# For Tomcat / NetBeans: keep .env at project root (cùng cấp với thư mục src).
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SENDER_USERNAME=your@gmail.com
MAIL_SENDER_PASSWORD=your_gmail_app_password

# Cloudinary - hồ sơ thí sinh (upload ngay, folder pending để staff xem qua app)
# Tạo tại https://cloudinary.com - lấy key tại API Keys.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Tuỳ chọn - mặc định: dlem/pending/p{profileId}/{DocumentType}/{uuid}
# CLOUDINARY_FOLDER_PREFIX=dlem/pending
# CLOUDINARY_ACCESS_TYPE=authenticated
# CLOUDINARY_SIGNED_URL_TTL_SECONDS=1800

# SePay Payment Gateway - https://developer.sepay.vn
# Lấy MERCHANT_ID + SECRET_KEY tại https://my.sepay.vn (sandbox trước, production sau).
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=your_merchant_id
SEPAY_SECRET_KEY=your_secret_key
# URL gốc app (public) - dùng ghép callback mặc định nếu không set từng URL riêng
SEPAY_APP_BASE_URL=https://your-domain.example.com/Driving-Licence-Examination-Management-Monolith
# SEPAY_SUCCESS_URL=https://your-domain.example.com/.../payment/sepay/success
# SEPAY_ERROR_URL=https://your-domain.example.com/.../payment/sepay/error
# SEPAY_CANCEL_URL=https://your-domain.example.com/.../payment/sepay/cancel
# Secret xác thực IPN (header X-Secret-Key) - mặc định = SEPAY_SECRET_KEY
# SEPAY_IPN_SECRET=your_ipn_secret
# Tuỳ chọn override endpoint checkout
# SEPAY_CHECKOUT_URL=https://pgapi-sandbox.sepay.vn/v1/checkout/init
