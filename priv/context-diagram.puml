@startuml DLEM_System_Context_Diagram
' ============================================================
' System Context Diagram - Driving Licence Examination Management (DLEM)
' All actors from UC.md / RoleType (including planned modules)
' Render: PlantUML extension, plantuml.com, or: plantuml priv/context-diagram.puml
' ============================================================

skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontName Arial
skinparam titleFontSize 16
skinparam rectangle {
  BackgroundColor #D6EAF8
  BorderColor #2E86AB
  FontColor #1A5276
}
skinparam actor {
  BackgroundColor #FCF3CF
  BorderColor #B7950B
}
skinparam database {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam cloud {
  BackgroundColor #E8DAEF
  BorderColor #8E44AD
}
skinparam note {
  BackgroundColor #FDFEFE
  BorderColor #AAB7B8
}

title System Context Diagram\nDriving Licence Examination Management System (DLEM)

' ---------- Human actors (all roles) ----------
actor "Guest\n(Khách truy cập)" as guest

actor "Registrant\n(Người đăng ký thi)" as registrant

actor "Candidate\n(Thí sinh)" as candidate

actor "Managing Staff\n(Cán bộ quản lý)" as mstaff

actor "Exam Staff\n(Cán bộ kỳ thi)" as estaff

actor "Examiner\n(Sát hạch viên)" as examiner

actor "Admin\n(Quản trị viên)" as admin

' ---------- Central system ----------
rectangle "**Driving Licence Examination\nManagement System (DLEM)**\n\nMonolithic web application\n(Servlet / JSP / JDBC)\nModules: general, auth,\nexamstaff, examiner" as dlem

' ---------- External systems ----------
database "**SQL Server**\nDLEM_DB_2" as db

cloud "**Email Service**\n(Gmail SMTP)" as email

cloud "**Payment Service**\n(QR code / Cash)" as payment

cloud "**Face ID Service**\n(Identity verification)" as faceid

cloud "**SMS Gateway**" as sms

cloud "**Document Storage**\n(uploaded files)" as storage

' ---------- Guest ----------
guest --> dlem : View home, licence info,\nprocess guide (UC-01–04)
guest --> dlem : Register account (UC-05)

' ---------- Registrant ----------
registrant --> dlem : Login / logout / change password\n(UC-06–08)
registrant --> dlem : Dashboard, profile, documents\n(UC-09–11)
registrant --> dlem : Exam registration, schedule,\nstatus, cancellation (UC-12–18)
registrant --> dlem : View scores & exam details\n(UC-16–17)

' ---------- Candidate (exam day - no login) ----------
candidate --> dlem : Identity verification (UC-19)
candidate --> dlem : Pay exam fee (UC-20)
candidate --> dlem : Take exam, save answers\n(UC-21–22)

' ---------- Managing Staff ----------
mstaff --> dlem : Staff login / password recovery\n(UC-23–24)
mstaff --> dlem : Dashboard, audit log (UC-25–26)
mstaff --> dlem : Manage registrants & users\n(UC-27, UC-29)
mstaff --> dlem : Approve registrations (UC-28)
mstaff --> dlem : Update documents (UC-30)
mstaff --> dlem : Import candidates (UC-31)
mstaff --> dlem : Create & manage exams (UC-32–33)
mstaff --> dlem : Notify registrants (UC-34)

' ---------- Exam Staff ----------
estaff --> dlem : Staff login (UC-23)
estaff --> dlem : Dashboard (UC-25)
estaff --> dlem : Manage exam roster (UC-35)
estaff --> dlem : Check-in, process dossier (UC-36–37)
estaff --> dlem : Start / end exam session (UC-38–39)
estaff --> dlem : Handle absent candidates (UC-40)
estaff --> dlem : Export reports (UC-41)

' ---------- Examiner ----------
examiner --> dlem : Staff login (UC-23)
examiner --> dlem : Dashboard, select exam (UC-25)
examiner --> dlem : Allocate / call candidates (UC-42)
examiner --> dlem : Manage results & violations\n(UC-43–45)
examiner --> dlem : Generate theory paper (UC-46)
examiner --> dlem : Print / export results (UC-47)

' ---------- Admin ----------
admin --> dlem : Staff login (UC-23)
admin --> dlem : Dashboard (UC-25)
admin --> dlem : Manage accounts & staff (UC-48–49)
admin --> dlem : Manage licences & fees (UC-50–52)
admin --> dlem : Manage exam areas & devices (UC-53–55)
admin --> dlem : View full audit log (UC-56)

' ---------- External dependencies ----------
dlem --> db : Read / write persistence\n(31 entities, JDBC)
dlem --> email : Registration credentials,\npassword recovery, notifications
dlem --> payment : Record & verify\nexam fee transactions
dlem --> faceid : Candidate identity check\nbefore exam
dlem --> sms : Exam reminders & alerts\n(planned)
dlem --> storage : Store & retrieve\nprofile documents

note right of candidate
  **No system account.**
  Identified by SBD (candidate number)
  on exam day. Separate from
  Registrant / User / Profile.
end note

note bottom of dlem
  **Implementation status**
  Implemented: general, auth,
  examstaff, examiner modules.
  Planned: registrant portal,
  admin CRUD, payment, Face ID, SMS.
end note

legend right
  |= Actor |= Access |
  | Guest | Public pages, registration |
  | Registrant | /login - online portal |
  | Candidate | Exam day - SBD only |
  | Managing Staff | /staff/login |
  | Exam Staff | /staff/login |
  | Examiner | /staff/login |
  | Admin | /staff/login |
endlegend

@enduml
