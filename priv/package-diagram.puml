@startuml DLEM_Package_Diagram_New_Design
' ============================================================
' Package Diagram - DLEM New Design (Module Isolation)
' Includes implemented + planned feature modules
' Style aligned with layered architecture reference
' ============================================================

skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam titleFontSize 16

title 1.2 Package Diagram\nDriving Licence Examination Management System (DLEM)\nFeature-module isolation over shared core

legend right
  |= Color |= Status |
  | <#D6EAF8> | Implemented |
  | <#FCF3CF> | Planned (to implement) |
  | <#D5F5E3> | Shared core (cross-module) |
endlegend

' ===================== PRESENTATION =====================
package "views" as views #FADBD8 {

  package "general" as v_general {
    [home.jsp]
    [license-categories.jsp]
    [process.jsp]
  }

  package "auth" as v_auth {
    [login.jsp]
    [register.jsp]
    [change-password.jsp]
    [staff/login.jsp]
  }

  package "examiner" as v_examiner {
    [dashboard.jsp]
    [candidate-call.jsp]
    [score-entry.jsp]
    [violations.jsp]
    [export.jsp]
  }

  package "staff.examstaff" as v_examstaff {
    [dashboard.jsp]
    [allocation.jsp]
    [procedure.jsp]
    [report.jsp]
    [audit.jsp]
  }

  package "registrant" as v_registrant #FCF3CF {
    [dashboard.jsp]
    [profile.jsp]
    [exam-registration.jsp]
    [documents.jsp]
  }

  package "staff.managing" as v_managing #FCF3CF {
    [dashboard.jsp]
    [registrants.jsp]
    [exams.jsp]
    [audit.jsp]
  }

  package "admin" as v_admin #FCF3CF {
    [dashboard.jsp]
    [accounts.jsp]
    [licences.jsp]
    [exam-areas.jsp]
    [devices.jsp]
  }

  package "layout" as v_layout {
    [header.jsp]
    [sidebar-*.jsp]
    [footer.jsp]
  }

  package "public" as v_public {
    [public-call.jsp]
  }
}

' ===================== FEATURE MODULES (IMPLEMENTED) =====================
package "general" as mod_general #D6EAF8 {

  package "controller" as gen_ctrl
  package "service" as gen_svc
  package "dao" as gen_dao
  package "dto" as gen_dto

  gen_ctrl -[hidden]down- gen_svc
  gen_svc -[hidden]down- gen_dao
  gen_dao -[hidden]right- gen_dto
}

package "auth" as mod_auth #D6EAF8 {

  package "controller.general" as auth_ctrl_gen
  package "controller.internal" as auth_ctrl_int
  package "service" as auth_svc
  package "dao" as auth_dao
  package "dto" as auth_dto
  package "util" as auth_util

  auth_ctrl_gen -[hidden]down- auth_svc
  auth_ctrl_int -[hidden]down- auth_svc
}

package "examstaff" as mod_examstaff #D6EAF8 {

  package "filter" as es_filter
  package "controller" as es_ctrl
  package "service" as es_svc
  package "dao" as es_dao
  package "dto" as es_dto
  package "enums" as es_enums
  package "util" as es_util

  es_filter -[hidden]down- es_ctrl
  es_ctrl -[hidden]down- es_svc
  es_svc -[hidden]down- es_dao
}

package "examiner" as mod_examiner #D6EAF8 {

  package "filter" as ex_filter
  package "controller" as ex_ctrl
  package "service" as ex_svc
  package "dao" as ex_dao
  package "dto" as ex_dto
  package "util" as ex_util

  ex_filter -[hidden]down- ex_ctrl
  ex_ctrl -[hidden]down- ex_svc
  ex_svc -[hidden]down- ex_dao
}

' ===================== FEATURE MODULES (PLANNED) =====================
package "registrant" as mod_registrant #FCF3CF {

  package "filter" as reg_filter
  package "controller" as reg_ctrl
  package "service" as reg_svc
  package "dao" as reg_dao
  package "dto" as reg_dto
  package "util" as reg_util

  note bottom of mod_registrant
    UC-09–18
    Online portal
  end note
}

package "managingstaff" as mod_managing #FCF3CF {

  package "filter" as mg_filter
  package "controller" as mg_ctrl
  package "service" as mg_svc
  package "dao" as mg_dao
  package "dto" as mg_dto
  package "util" as mg_util

  note bottom of mod_managing
    UC-26–34
    Registrant & exam mgmt
  end note
}

package "admin" as mod_admin #FCF3CF {

  package "filter" as ad_filter
  package "controller" as ad_ctrl
  package "service" as ad_svc
  package "dao" as ad_dao
  package "dto" as ad_dto
  package "util" as ad_util

  note bottom of mod_admin
    UC-48–56
    System administration
  end note
}

' ===================== SHARED CORE =====================
package "shared" as shared #D5F5E3 {

  package "model" as sh_model
  package "enums" as sh_enums
  package "dbconnection" as sh_db
  package "util" as sh_util
  [Attributes]

  sh_model -[hidden]right- sh_enums
  sh_enums -[hidden]right- sh_db
  sh_db -[hidden]right- sh_util
}

' ===================== LAYER RULES (per module) =====================
together {
  object "Layer flow\n(each module)" as layer_note #FEFEFF
}

' --- views <-> controllers ---
gen_ctrl ..> v_general : <<forward JSP>>
auth_ctrl_gen ..> v_auth : <<forward JSP>>
auth_ctrl_int ..> v_auth : <<forward JSP>>
es_ctrl ..> v_examstaff : <<forward JSP>>
ex_ctrl ..> v_examiner : <<forward JSP>>
reg_ctrl ..> v_registrant : <<forward JSP>>\n(planned)
mg_ctrl ..> v_managing : <<forward JSP>>\n(planned)
ad_ctrl ..> v_admin : <<forward JSP>>\n(planned)
es_ctrl ..> v_public : <<forward JSP>>
ex_ctrl ..> v_layout : <<include>>

' --- filter -> controller ---
es_filter ..> es_ctrl : <<passes request>>
ex_filter ..> ex_ctrl : <<passes request>>
reg_filter ..> reg_ctrl : <<passes request>>\n(planned)
mg_filter ..> mg_ctrl : <<passes request>>\n(planned)
ad_filter ..> ad_ctrl : <<passes request>>\n(planned)

' --- controller -> service ---
gen_ctrl ..> gen_svc : <<use>>
auth_ctrl_gen ..> auth_svc : <<use>>
auth_ctrl_int ..> auth_svc : <<use>>
es_ctrl ..> es_svc : <<use>>
ex_ctrl ..> ex_svc : <<use>>
reg_ctrl ..> reg_svc : <<use>>
mg_ctrl ..> mg_svc : <<use>>
ad_ctrl ..> ad_svc : <<use>>

' --- service -> dao, dto, enums, util ---
gen_svc ..> gen_dao : <<use>>
gen_svc ..> gen_dto : <<use>>
auth_svc ..> auth_dao : <<use>>
auth_svc ..> auth_dto : <<use>>
auth_svc ..> auth_util : <<use>>
es_svc ..> es_dao : <<use>>
es_svc ..> es_dto : <<use>>
es_svc ..> es_enums : <<use>>
es_svc ..> es_util : <<use>>
ex_svc ..> ex_dao : <<use>>
ex_svc ..> ex_dto : <<use>>
ex_svc ..> ex_util : <<use>>
reg_svc ..> reg_dao : <<use>>
reg_svc ..> reg_dto : <<use>>
mg_svc ..> mg_dao : <<use>>
mg_svc ..> mg_dto : <<use>>
ad_svc ..> ad_dao : <<use>>
ad_svc ..> ad_dto : <<use>>

' --- dao/dto -> shared.model ---
gen_dao ..> sh_model : <<map>>
gen_dto ..> sh_model : <<map>>
auth_dao ..> sh_model : <<map>>
auth_dto ..> sh_model : <<map>>
es_dao ..> sh_model : <<map>>
es_dto ..> sh_model : <<map>>
ex_dao ..> sh_model : <<map>>
ex_dto ..> sh_model : <<map>>
reg_dao ..> sh_model : <<map>>
reg_dto ..> sh_model : <<map>>
mg_dao ..> sh_model : <<map>>
mg_dto ..> sh_model : <<map>>
ad_dao ..> sh_model : <<map>>
ad_dto ..> sh_model : <<map>>

' --- dao -> dbconnection ---
gen_dao ..> sh_db : <<access>>
auth_dao ..> sh_db : <<access>>
es_dao ..> sh_db : <<access>>
ex_dao ..> sh_db : <<access>>
reg_dao ..> sh_db : <<access>>
mg_dao ..> sh_db : <<access>>
ad_dao ..> sh_db : <<access>>

' --- all modules use shared enums/util ---
gen_svc ..> sh_enums : <<use>>
auth_svc ..> sh_enums : <<use>>
es_svc ..> sh_enums : <<use>>
ex_svc ..> sh_enums : <<use>>
reg_svc ..> sh_enums : <<use>>
mg_svc ..> sh_enums : <<use>>
ad_svc ..> sh_enums : <<use>>

gen_ctrl ..> sh_util : <<use>>
auth_ctrl_gen ..> sh_util : <<use>>
es_ctrl ..> sh_util : <<use>>
ex_ctrl ..> sh_util : <<use>>

' --- isolation rule ---
note as isolation_rule
  **Module isolation rule**
  ─────────────────────
  • Modules do NOT share Service or DAO code
  • Each module owns a full layer stack (copy, not import)
  • Only **shared.*** crosses module boundaries:
    model · enums · dbconnection · util · Attributes
  • Dependency flow (per module):
    JSP → Filter → Controller → Service → DAO → DB
end note

mod_general -[hidden]right- mod_auth
mod_auth -[hidden]right- mod_examstaff
mod_examstaff -[hidden]right- mod_examiner
mod_examiner -[hidden]right- mod_registrant
mod_registrant -[hidden]right- mod_managing
mod_managing -[hidden]right- mod_admin

@enduml
